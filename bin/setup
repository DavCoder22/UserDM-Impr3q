#!/usr/bin/env bash

# Colores para la salida
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Función para mostrar mensajes de éxito
echo_success() {
  echo -e "${GREEN}✓ $1${NC}"
}

# Función para mostrar mensajes de error
echo_error() {
  echo -e "${RED}✗ $1${NC}"
  exit 1
}

# Función para mostrar mensajes informativos
echo_info() {
  echo -e "${YELLOW}ℹ $1${NC}"
}

# Verificar si se está ejecutando como root
if [[ $EUID -eq 0 ]]; then
  echo_error "Este script no debe ejecutarse como root"
fi

# Verificar si se está utilizando bash
if [ -z "$BASH_VERSION" ]; then
  echo_error "Por favor, ejecuta este script con bash"
fi

# Título
echo -e "\n${YELLOW}================================${NC}"
echo -e "${YELLOW}  Configuración del Entorno de Desarrollo  ${NC}"
echo -e "${YELLOW}================================${NC}\n"

# 1. Verificar dependencias
echo_info "1. Verificando dependencias..."

# Verificar Ruby
if ! command -v ruby &> /dev/null; then
  echo_error "Ruby no está instalado. Por favor, instala Ruby 3.2.2"
else
  RUBY_VERSION=$(ruby -v | cut -d ' ' -f 2)
  if [[ "$RUBY_VERSION" != "3.2.2"* ]]; then
    echo_error "Se requiere Ruby 3.2.2. Versión actual: $RUBY_VERSION"
  else
    echo_success "Ruby $RUBY_VERSION está instalado"
  fi
fi

# Verificar Bundler
if ! command -v bundle &> /dev/null; then
  echo_info "Instalando Bundler..."
  gem install bundler:2.4.10 || echo_error "Error al instalar Bundler"
  echo_success "Bundler instalado correctamente"
else
  echo_success "Bundler está instalado"
fi

# Verificar PostgreSQL
if ! command -v psql &> /dev/null; then
  echo_error "PostgreSQL no está instalado. Por favor, instala PostgreSQL 13 o superior"
else
  echo_success "PostgreSQL está instalado"
fi

# Verificar Redis
if ! command -v redis-cli &> /dev/null; then
  echo_error "Redis no está instalado. Por favor, instala Redis 6 o superior"
else
  echo_success "Redis está instalado"
fi

# Verificar Docker (opcional)
if command -v docker &> /dev/null; then
  echo_success "Docker está instalado"
  DOCKER_INSTALLED=true
else
  echo_info "Docker no está instalado. Algunas funcionalidades no estarán disponibles"
  DOCKER_INSTALLED=false
fi

# 2. Instalar dependencias de Ruby
echo_info "\n2. Instalando dependencias de Ruby..."
bundle install || echo_error "Error al instalar las dependencias de Ruby"
echo_success "Dependencias de Ruby instaladas correctamente"

# 3. Configurar base de datos
echo_info "\n3. Configurando base de datos..."

# Crear base de datos de desarrollo
bundle exec rake db:create || echo_error "Error al crear la base de datos de desarrollo"

# Ejecutar migraciones
bundle exec rake db:migrate || echo_error "Error al ejecutar migraciones"

# Crear base de datos de prueba
bundle exec rake db:test:prepare || echo_error "Error al preparar la base de datos de prueba"

echo_success "Bases de datos configuradas correctamente"

# 4. Instalar dependencias de JavaScript (si existen)
if [ -f "package.json" ]; then
  echo_info "\n4. Instalando dependencias de JavaScript..."
  
  # Verificar si yarn está instalado
  if command -v yarn &> /dev/null; then
    yarn install || echo_error "Error al instalar dependencias de JavaScript con Yarn"
    echo_success "Dependencias de JavaScript instaladas con Yarn"
  # Verificar si npm está instalado
  elif command -v npm &> /dev/null; then
    npm install || echo_error "Error al instalar dependencias de JavaScript con npm"
    echo_success "Dependencias de JavaScript instaladas con npm"
  else
    echo_info "Ni Yarn ni npm están instalados. No se instalarán dependencias de JavaScript"
  fi
fi

# 5. Configurar variables de entorno
echo_info "\n5. Configurando variables de entorno..."

if [ ! -f ".env" ] && [ -f ".env.example" ]; then
  cp .env.example .env
  echo_success "Archivo .env creado a partir de .env.example"
  echo_info "Por favor, edita el archivo .env con tus configuraciones"
else
  echo_info "El archivo .env ya existe"
fi

# 6. Configurar Git hooks (opcional)
echo_info "\n6. Configurando Git hooks..."

if [ -d ".git" ]; then
  # Crear directorio de hooks si no existe
  mkdir -p .git/hooks
  
  # Crear pre-commit hook
  cat > .git/hooks/pre-commit << 'EOL'
#!/bin/bash

# Ejecutar RuboCop
echo "Ejecutando RuboCop..."
bundle exec rubocop -a

# Si hay errores, salir con código de error
if [ $? -ne 0 ]; then
  echo "✗ Se encontraron errores en RuboCop. Por favor, corrígelos antes de hacer commit."
  exit 1
fi

# Ejecutar pruebas rápidas
echo "Ejecutando pruebas rápidas..."
bundle exec rspec --fail-fast

# Si hay errores, salir con código de error
if [ $? -ne 0 ]; then
  echo "✗ Algunas pruebas fallaron. Por favor, corrígelas antes de hacer commit."
  exit 1
fi

echo "✓ Todo en orden. Haciendo commit..."
exit 0
EOL

  # Hacer ejecutable el hook
  chmod +x .git/hooks/pre-commit
  echo_success "Pre-commit hook configurado correctamente"
else
  echo_info "No se encontró un repositorio Git. Omitiendo configuración de hooks"
fi

# 7. Mensaje final
echo -e "\n${GREEN}✓ Configuración completada con éxito!${NC}"
echo -e "\nPara iniciar el servidor de desarrollo, ejecuta: ${YELLOW}rerun${NC}"
echo -e "Para ejecutar las pruebas, usa: ${YELLOW}bundle exec rspec${NC}"
echo -e "Para ver la cobertura de código, ejecuta: ${YELLOW}COVERAGE=true bundle exec rspec${NC}"
echo -e "Para ejecutar RuboCop: ${YELLOW}bundle exec rubocop${NC}"
echo -e "\n¡Listo para comenzar a desarrollar! 🚀\n"
