# Define networks for better isolation
networks:
  app_network:
    driver: bridge

services:
  # Nginx as Load Balancer
  nginx_alb:
    image: nginx:alpine
    container_name: nginx_alb
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - auth-register-service
      - auth-login-service
      - auth-profile-service
      - auth-password-service
      - auth-logout-service
      - auth-history-service
    networks:
      - app_network
    restart: unless-stopped

  # Database
  db:
    image: postgres:15-alpine
    container_name: auth_db
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-auth_db}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./db/migrations:/docker-entrypoint-initdb.d
    ports:
      - "5432:5432"
    networks:
      - app_network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-auth_db}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  # Redis for token blacklist and session management
  redis:
    image: redis:alpine
    container_name: auth_redis
    command: redis-server --requirepass ${REDIS_PASSWORD}
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    networks:
      - app_network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 30s
      retries: 5
    restart: unless-stopped

  # Register Service
  auth-register-service:
    build:
      context: .
      dockerfile: auth-register-service/Dockerfile
    environment:
      - RACK_ENV=production
      - JWT_SECRET=${JWT_SECRET}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/auth_db
      - REDIS_URL=redis://:${REDIS_PASSWORD:-your_secure_password}@redis:6379/0
    expose:
      - "3000"
    depends_on:
      - db
      - redis
    networks:
      - app_network
    restart: unless-stopped

  # Login Service
  auth-login-service:
    build:
      context: .
      dockerfile: auth-login-service/Dockerfile
    environment:
      - RACK_ENV=production
      - JWT_SECRET=${JWT_SECRET}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/auth_db
      - REDIS_URL=redis://:${REDIS_PASSWORD:-your_secure_password}@redis:6379/0
    expose:
      - "3000"
    depends_on:
      - db
      - redis
    networks:
      - app_network
    restart: unless-stopped

  # Profile Service
  auth-profile-service:
    build:
      context: .
      dockerfile: auth-profile-service/Dockerfile
    environment:
      - RACK_ENV=production
      - JWT_SECRET=${JWT_SECRET}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/auth_db
      - REDIS_URL=redis://:${REDIS_PASSWORD:-your_secure_password}@redis:6379/0
    expose:
      - "3000"
    depends_on:
      - db
      - redis
    networks:
      - app_network
    restart: unless-stopped

  # Password Service
  auth-password-service:
    build:
      context: .
      dockerfile: auth-password-service/Dockerfile
    environment:
      - RACK_ENV=production
      - JWT_SECRET=${JWT_SECRET}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/auth_db
      - REDIS_URL=redis://:${REDIS_PASSWORD:-your_secure_password}@redis:6379/0
    expose:
      - "3000"
    depends_on:
      - db
      - redis
    networks:
      - app_network
    restart: unless-stopped

  # Logout Service
  auth-logout-service:
    build:
      context: .
      dockerfile: auth-logout-service/Dockerfile
    environment:
      - RACK_ENV=production
      - JWT_SECRET=${JWT_SECRET}
      - REDIS_URL=redis://:${REDIS_PASSWORD:-your_secure_password}@redis:6379/0
    expose:
      - "3000"
    depends_on:
      - redis
    networks:
      - app_network
    restart: unless-stopped

  # History Service
  auth-history-service:
    build:
      context: .
      dockerfile: auth-history-service/Dockerfile
    environment:
      - RACK_ENV=production
      - JWT_SECRET=${JWT_SECRET}
      - DATABASE_URL=postgres://postgres:postgres@db:5432/auth_db
      - REDIS_URL=redis://:${REDIS_PASSWORD:-your_secure_password}@redis:6379/0
    expose:
      - "3000"
    depends_on:
      - db
      - redis
    networks:
      - app_network
    restart: unless-stopped

  # Health check service
  health-check:
    image: nginx:alpine
    ports:
      - "8080:80"
    volumes:
      - ./health-check:/usr/share/nginx/html
    networks:
      - app_network
    restart: unless-stopped

# Volumes for persistent data
volumes:
  postgres_data:
  redis_data:
