# Configuración de Base de Datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=auth_db
DATABASE_URL=postgres://postgres:your_secure_password_here@db:5432/auth_db

# Configuración de Redis
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379/0

# Configuración de JWT
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
JWT_EXPIRATION=3600

# Configuración de CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Configuración de Email (para alertas de seguridad)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_DOMAIN=gmail.com

# Configuración de Seguridad
SESSION_SECRET=your_session_secret_here
PEPPER=your_pepper_for_password_hashing

# Configuración de Entorno
RACK_ENV=development
NODE_ENV=development

# Configuración de Servicios
AUTH_SERVICE_URL=http://auth-login-service:3000
PROFILE_SERVICE_URL=http://auth-profile-service:3000
HISTORY_SERVICE_URL=http://auth-history-service:3000

# Configuración de Logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Configuración de Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# Configuración de Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Configuración de Docker
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest 